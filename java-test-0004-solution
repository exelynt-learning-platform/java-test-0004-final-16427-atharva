public class ConcentricSquare {
    public static void main(String[] args) {
        final int MAX_NUMBER = 4;
        final int GRID_SIZE = 2 * MAX_NUMBER - 1;

        for (int i = 0; i < GRID_SIZE; i++) {
            for (int j = 0; j < GRID_SIZE; j++) {
                int distTop = i;
                int distBottom = GRID_SIZE - 1 - i;
                int distLeft = j;
                int distRight = GRID_SIZE - 1 - j;

                int minDistanceToEdge = Math.min(Math.min(distTop, distBottom), Math.min(distLeft, distRight));
                int printValue = MAX_NUMBER - minDistanceToEdge;

                System.out.print(printValue + " ");
            }
            System.out.println();
        }
    }
}
